{
  "name": "@magro-ui/react",
  "version": "0.0.6",
  "type": "module",
  "description": "Lean React Component library.",
  "author": "Micha Buchholz <mail@lean-stack.rocks>",
  "homepage": "https://lean-stack.rocks",
  "license": "MIT",
  "keywords": [
    "components",
    "lean components",
    "react components",
    "react ui"
  ],
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "style": "./dist/theme/core.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lean-stack/magro-ui.git",
    "directory": "packages/core/react"
  },
  "scripts": {
    "dev": "tsdown --watch --dts --copy styles/theme",
    "build": "tsdown --dts --copy styles/theme",
    "typecheck": "tsc",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "cva": "1.0.0-beta.4",
    "react-aria-components": "^1.17.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "clean-package": "^2.2.0",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.12.9",
    "typescript": "~5.8.3"
  },
  "clean-package": "../../clean-package.config.json"
}
